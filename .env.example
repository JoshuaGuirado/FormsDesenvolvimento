# SMTP usado para enviar o briefing (o mesmo do site da Linka serve).
# Com Gmail, use uma "senha de app": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# E-mail que recebe os briefings
BRIEFING_TO=contato@linkamidia.com.br

# "true" envia ao cliente uma cópia das respostas
SEND_CLIENT_COPY=true

# Supabase (Project Settings → API Keys). Use a chave SECRETA (sb_secret_... ou a antiga service_role).
# Ela fica só no servidor: nunca coloque NEXT_PUBLIC_ na frente.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Senha do painel /admin. Use uma senha longa; trocar a senha desconecta todo mundo.
ADMIN_PASSWORD=

# Texto aleatório que protege a rota que mantém o Supabase ativo (o Cron da Vercel envia sozinho).
# Gere um com: openssl rand -hex 32
CRON_SECRET=
